rue, "compiled_code": "\n    \n    \n\nselect\n    customer_id as unique_field,\n    count(*) as n_records\n\nfrom \"warehouse\".\"main_marts\".\"dim_customers\"\nwhere customer_id is not null\ngroup by customer_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-19T06:08:46.896628Z", "completed_at": "2026-09-19T06:08:46.898710Z"}, {"name": "execute", "started_at": "2026-09-19T06:08:46.899193Z", "completed_at": "2026-09-19T06:08:46.899200Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0036911964416503906, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ecommerce_analytics.fct_orders", "compiled": true, "compiled_code": "with orders as (\n    select * from \"warehouse\".\"main_staging\".\"stg_orders\"\n),\n\nproducts as (\n    select * from \"warehouse\".\"main_marts\".\"dim_products\"\n)\n\nselect\n    o.order_id,\n    o.customer_id,\n    o.product_id,\n    o.order_ts,\n    date_trunc('day', o.order_ts) as order_date,\n    o.quantity,\n    o.device_type,\n    o.status,\n    p.category,\n    p.unit_price,\n    round(o.quantity * p.unit_price, 2) as gross_revenue,\n    case when o.status = 'completed' then round(o.quantity * p.unit_price, 2) else 0 end as net_revenue\nfrom orders o\nleft join products p on o.product_id = p.product_id", "relation_name": "\"warehouse\".\"main_marts\".\"fct_orders\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-19T06:08:46.901551Z", "completed_at": "2026-09-19T06:08:46.908310Z"}, {"name": "execute", "started_at": "2026-09-19T06:08:46.908776Z", "completed_at": "2026-09-19T06:08:46.908783Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.008385181427001953, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.ecommerce_analytics.not_null_dim_products_produc