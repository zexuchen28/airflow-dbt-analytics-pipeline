{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.5", "generated_at": "2026-09-19T06:08:47.011815Z", "invocation_id": "576941a7-c6d8-42f6-8424-00576365a638", "invocation_started_at": "2026-09-19T06:08:45.864780Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-19T06:08:46.687898Z", "completed_at": "2026-09-19T06:08:46.725050Z"}, {"name": "execute", "started_at": "2026-09-19T06:08:46.725607Z", "completed_at": "2026-09-19T06:08:46.725623Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.04004335403442383, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ecommerce_analytics.metricflow_time_spine", "compiled": true, "compiled_code": "-- Required by the dbt Semantic Layer / MetricFlow whenever a semantic model\n-- uses a `type: time` dimension (see order_date in _semantic_models.yml).\n-- This is a generic date spine, not business data \u2014 it doesn't depend on\n-- any other model and just needs to cover the full range dates in\n-- fct_orders could ever fall in.\n-- Docs: https://docs.getdbt.com/docs/build/metricflow-time-spine\n\n\n\nwith days as (\n    \n\n\n\n\n\nwith rawdata as (\n\n    \n\n    \n\n    with p as (\n        select 0 as generated_number union all select 1\n    ), unioned as (\n\n    select\n\n    \n    p0.generated_number * power(2, 0)\n     + \n    \n    p1.generated_number * power(2, 1)\n     + \n    \n    p2.generated_number * power(2, 2)\n     + \n    \n    p3.generated_number * power(2, 3)\n     + \n    \n    p4.generated_number * power(2, 4)\n     + \n    \n    p5.generated_number * power(2, 5)\n     + \n    \n    p6.generated_number * power(2, 6)\n     + \n    \n    p7.generated_number * power(2, 7)\n     + \n    \n    p8.generated_number * power(2, 8)\n     + \n    \n    p9.generated_number * power(2, 9)\n     + \n    \n    p10.generated_number * power(2, 10)\n     + \n    \n    p11.generated_number * power(2, 11)\n    \n    \n    + 1\n    as generated_number\n\n    from\n\n    \n    p as p0\n     cross join \n    \n    p as p1\n     cross join \n    \n    p as p2\n     cross join \n    \n    p as p3\n     cross join \n    \n    p as p4\n     cross join \n    \n    p as p5\n     cross join \n    \n    p as p6\n     cross join \n    \n    p as p7\n     cross join \n    \n    p as p8\n     cross join \n    \n    p as p9\n     cross join \n    \n    p as p10\n     cross join \n    \n    p as p11\n    \n    \n\n    )\n\n    select *\n    from unioned\n    where generated_number <= 3653\n    order by generated_number\n\n\n\n),\n\nall_periods as (\n\n    select (\n        \n\n    (cast('2020-01-01' as date) + cast(row_number() over (order by generated_number) - 1 as bigint) * interval 1 day)\n    ) as date_day\n    from rawdata\n\n),\n\nfiltered as (\n\n    select *\n    from all_periods\n    where date_day <= cast('2030-01-01' as date)\n\n)\n\nselect * from filtered\n\n\n)\n\nselect cast(date_day as date) as date_day\nfrom days", "relation_name": "\"warehouse\".\"main_marts\".\"metricflow_time_spine\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-19T06:08:46.729177Z", "completed_at": "2026-09-19T06:08:46.731212Z"}, {"name": "execute", "started_at": "2026-09-19T06:08:46.731688Z", "completed_at": "2026-09-19T06:08:46.731698Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.003639698028564453, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.ecommerce_analytics.stg_customers", "compiled": true, "compiled_code": "with source as (\n    select * from \"warehouse\".\"raw\".\"customers\"\n)\n\nselect\n    customer_id::int as customer_id,\n    cast(signup_date as date) as signup_date,\n    region,\n    is_member::boolean as is_member\nfrom source", "relation_name": "\"warehouse\".\"main_staging\".\"stg_customers\"", "batch_results": null, "overload